# ==============================================================================
# URL Shortener & Distributed Analytics Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="LinkScale Platform"
API_V1_STR=/api/v1
DEBUG=false
SECRET_KEY=replace-with-a-very-secure-random-secret-key-at-least-32-chars-long
BASE_URL=http://localhost:8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database Configuration
# In production / Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/urlshortener
# In local development / fallback tests: sqlite+aiosqlite:///./urlshortener.db
DATABASE_URL=sqlite+aiosqlite:///./urlshortener.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Configuration
# In production / Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_TIMEOUT_SECONDS=2.0
REDIS_URL_CACHE_TTL_SECONDS=86400
REDIS_CACHE_NULL_TTL_SECONDS=300
REDIS_RATE_LIMIT_ENABLED=true

# Kafka Configuration
# In production / Docker Compose: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLICKS=url-click-events
KAFKA_TOPIC_DLQ=url-click-events-dlq
KAFKA_CONSUMER_GROUP=analytics-workers-group
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=500
KAFKA_PRODUCER_TIMEOUT_MS=1500
KAFKA_PRODUCER_FALLBACK_QUEUE_MAX=5000

# Authentication & Security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Rate Limiting (Default limits per IP/User)
RATE_LIMIT_ANONYMOUS_RPM=60
RATE_LIMIT_AUTHENTICATED_RPM=300
RATE_LIMIT_REDIRECT_RPM=1200

# URL Safety & SSRF Mitigation
ALLOW_PRIVATE_IPS=false
ALLOWED_URL_SCHEMES=http,https
MAX_URL_LENGTH=2048

# Observability & Metrics
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=url-shortener-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
LOG_FORMAT=json
